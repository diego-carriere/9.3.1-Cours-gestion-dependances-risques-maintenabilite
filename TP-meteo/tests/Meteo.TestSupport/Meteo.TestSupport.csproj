<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Bibliothèque de fakes, pas un projet de test exécutable : référence xunit pour
         GeocoderContractTests (une classe de base abstraite) sans le SDK de test complet.
         Sans ce flag, `dotnet test` sur la solution tente de l'exécuter comme suite VSTest. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- Bibliothèque de fakes partagée, pas un projet de test : référence les ports du
       Domaine pour offrir FakeGeocoder/FakeWeatherProvider/FakeClock aux autres projets
       de test, à la manière du FakeUserRepository de Support J1. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meteo.Domain\Meteo.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>
