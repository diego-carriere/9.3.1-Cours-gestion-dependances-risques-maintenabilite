{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Providers": {
    "Geocoder": "nominatim",
    "Weather": "open-meteo"
  },
  "Nominatim": {
    "UserAgent": "",
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "AcceptLanguage": "fr"
  },
  "Ban": {
    "BaseUrl": "https://api-adresse.data.gouv.fr/",
    "UserAgent": "TP2-MeteoApi/1.0",
    "Limit": 1
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com/",
    "HourlyVariable": "temperature_2m"
  }
}
